+export class DocumentPickerDialogComponent implements OnChanges {
+  private documentService = inject(DocumentService);
+  private stock = inject(StockService);
+  private msgs = inject(MessageService);
+
+  /** Project whose STOCK/BL folder will be listed. */
+  @Input({ required: true }) projectId!: string;
+  /** Two-way bound visibility (p-dialog pattern). */
+  @Input() visible: boolean = false;
+  /** Emitted when the user confirms a selection. */
+  @Output() picked = new EventEmitter<string>();
+  /** Emitted when the dialog closes without a selection. */
+  @Output() visibleChange = new EventEmitter<boolean>();
+
+  loading = signal(true);
+  error = signal<string | null>(null);
+  documents = signal<Document[]>([]);
+  selectedId = signal<string | null>(null);
+  search = '';
+
+  filtered = computed(() => {
+    const q = this.search.trim().toLowerCase();
+    return this.documents().filter(d => {
+      if (!q) return true;
+      return (d.title ?? '').toLowerCase().includes(q) ||
+             (d.reference ?? '').toLowerCase().includes(q);
+    });
+  });
+
+  ngOnChanges(): void {
+    if (this.visible && this.projectId) {
+      this.loadDocuments();
+    }
+  }
+
+  /** Resolve-or-create the STOCK/BL folder, then list its documents. */
+  private loadDocuments(): void {
+    this.loading.set(true);
+    this.error.set(null);
+    this.documents.set([]);
+    this.selectedId.set(null);
+    this.search = '';
+
+    this.stock.ensureStockFolder(this.projectId, 'BL' as StockDocKind).subscribe(folder => {
+      if (!folder?.folderId) {
+        this.loading.set(false);
+        this.error.set('Impossible de résoudre le dossier STOCK / BL du projet.');
+        return;
+      }
+      // List documents in that folder (size 50 — enough for a picker)
+      this.documentService.search(this.projectId, {
+        folderId: folder.folderId,
+        size: 50,
+      }).subscribe({
+        next: page => {
+          this.documents.set(page.items ?? []);
+          this.loading.set(false);
+        },
+        error: () => {
+          this.loading.set(false);
+          this.error.set('Impossible de charger les documents du dossier STOCK / BL.');
+        },
+      });
+    });
+  }
+
+  pick(d: Document): void {
+    this.selectedId.set(d.id);
+  }
+
+  confirm(): void {
+    const id = this.selectedId();
+    if (!id) return;
+    this.picked.emit(id);
+    this.visible = false;
+    this.visibleChange.emit(false);
+  }
+
+  cancel(): void {
+    this.visible = false;
+    this.visibleChange.emit(false);
+  }
+
+  onHide(): void {
+    this.visible = false;
+    this.visibleChange.emit(false);
+  }
+}
