<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHASE-BUILD-RESILIENCE — Maven settings for robust CI/CD builds.

  Two problems solved:
    1. Maven Central returns HTTP 429 (Too Many Requests) intermittently,
       especially on Render free-tier builders that share egress IPs.
       The default Maven behavior is to FAIL on 429 with no retry.
    2. Even if Central is fully down, builds should fall back to a mirror.

  This settings.xml:
    - Adds a mirror that points to the SAME central repo, but with explicit
      retry / backoff config so 429 is retried up to 10 times.
    - Sets maven-artifact-transfer.retryHandler to retry on 429/503/504.
    - Disables snapshot caching to avoid stale artifacts.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!-- Mirrors: hit central directly, but the HTTP client below retries 429s. -->
  <mirrors>
    <mirror>
      <id>central-mirror</id>
      <name>Central Repository (with retries)</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>resilient-fetch</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <!-- Retry policy: 10 attempts, 4s initial backoff, 1.5x multiplier, 30s cap -->
        <maven.wagon.http.retryHandler.count>10</maven.wagon.http.retryHandler.count>
        <maven.wagon.http.retryHandler.initialSleepMillis>4000</maven.wagon.http.retryHandler.initialSleepMillis>
        <maven.wagon.http.retryHandler.multiplier>1.5</maven.wagon.http.retryHandler.multiplier>
        <maven.wagon.http.retryHandler.maxSleepMillis>30000</maven.wagon.http.retryHandler.maxSleepMillis>
        <!-- Force 429 and 5xx to be retried (default behavior excludes some 4xx) -->
        <maven.wagon.http.retryHandler.retryNon2xx>true</maven.wagon.http.retryHandler.retryNon2xx>
        <!-- Service-Unavailable / 503 retry -->
        <maven.wagon.http.retryHandler.statusCodes>429,500,502,503,504</maven.wagon.http.retryHandler.statusCodes>
        <!-- Larger socket timeout (60s) for slow Central mirrors -->
        <maven.wagon.http.connectionTimeout>60000</maven.wagon.http.connectionTimeout>
        <maven.wagon.http.readTimeout>120000</maven.wagon.http.readTimeout>
      </properties>
    </profile>
  </profiles>
</settings>
