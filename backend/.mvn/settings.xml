<?xml version="1.0" encoding="UTF-8"?>
<!--
  PHASE-BUILD-RESILIENCE — Maven settings for robust CI/CD builds.

  Problem solved:
    Maven Central (repo.maven.apache.org / repo1.maven.org) intermittently
    returns HTTP 429 (Too Many Requests) for popular artifacts when Render's
    shared builder IPs hit per-IP rate limits. The default Maven behavior
    fails the build on 429 with no retry.

  Solution (two layers):
    1. Mirror: route all central requests through Aliyun's Maven Central
       mirror (full sync, not rate-limited, reliable from US/EU/Asia builders).
    2. Retry: configure Maven Wagon to retry up to 10 times with exponential
       backoff on 429/5xx, so even Aliyun's transient failures don't kill
       the build.

  Both layers together make the build resilient to any single-point failure.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">

  <!-- Mirror: Aliyun's full Maven Central sync. Not rate-limited, fast globally. -->
  <mirrors>
    <mirror>
      <id>aliyun-central</id>
      <name>Aliyun Maven Central Mirror</name>
      <url>https://maven.aliyun.com/repository/public</url>
      <mirrorOf>central</mirrorOf>
    </mirror>
  </mirrors>

  <profiles>
    <profile>
      <id>resilient-fetch</id>
      <activation>
        <activeByDefault>true</activeByDefault>
      </activation>
      <properties>
        <!-- Retry policy: 10 attempts, 4s initial backoff, 1.5x multiplier, 30s cap -->
        <maven.wagon.http.retryHandler.count>10</maven.wagon.http.retryHandler.count>
        <maven.wagon.http.retryHandler.initialSleepMillis>4000</maven.wagon.http.retryHandler.initialSleepMillis>
        <maven.wagon.http.retryHandler.multiplier>1.5</maven.wagon.http.retryHandler.multiplier>
        <maven.wagon.http.retryHandler.maxSleepMillis>30000</maven.wagon.http.retryHandler.maxSleepMillis>
        <!-- Force 429 and 5xx to be retried (default behavior excludes some 4xx) -->
        <maven.wagon.http.retryHandler.retryNon2xx>true</maven.wagon.http.retryHandler.retryNon2xx>
        <!-- Service-Unavailable / 503 retry -->
        <maven.wagon.http.retryHandler.statusCodes>429,500,502,503,504</maven.wagon.http.retryHandler.statusCodes>
        <!-- Larger socket timeout (60s) for slow mirrors -->
        <maven.wagon.http.connectionTimeout>60000</maven.wagon.http.connectionTimeout>
        <maven.wagon.http.readTimeout>120000</maven.wagon.http.readTimeout>
      </properties>
    </profile>
  </profiles>
</settings>
