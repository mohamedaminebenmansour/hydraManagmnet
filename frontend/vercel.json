{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/hydra-web/browser",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://hydramanagmnet.onrender.com/api/:path*"
    },
    {
      "source": "/((?!api).*)",
      "destination": "/index.html"
    }
  ]
}
